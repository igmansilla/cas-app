# ----------------------------------
# Keycloak Authentication Settings
# ----------------------------------
# URL of your Keycloak server
VITE_KEYCLOAK_URL=http://localhost:8181

# The name of the Keycloak realm your client belongs to
VITE_KEYCLOAK_REALM=cas

# The Client ID you configured in Keycloak for this frontend app
VITE_KEYCLOAK_CLIENT_ID=frontend-app

# ----------------------------------
# Backend API Settings
# ----------------------------------
# The base URL of your backend API
VITE_API_BASE_URL=http://localhost:8080/api

# ----------------------------------
# App Environment (dev/prod)
# ----------------------------------
# Used for UI differentiation (e.g., title shows [DEV])
VITE_APP_ENV=dev

# ----------------------------------
# Google Maps / Places
# ----------------------------------
# API key usada para autocompletar lugares y generar enlaces a Google Maps.
# Restringila por dominio y habilitá Maps JavaScript API + Places API (New).
VITE_GOOGLE_MAPS_API_KEY=

VITE_NOVU_APPLICATION_IDENTIFIER=J2Mm8bRAVUEJ
REACT_APP_NOVU_APPLICATION_IDENTIFIER=J2Mm8bRAVUEJ
VITE_NOVU_BACKEND_URL=
VITE_NOVU_SOCKET_URL=
